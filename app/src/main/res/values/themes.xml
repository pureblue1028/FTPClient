<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FtpClient" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/text_black</item>
        <item name="colorPrimaryVariant">@color/text_black</item>
        <item name="colorOnPrimary">@color/bg_white</item>
        <item name="colorSecondary">@color/text_black</item>
        <item name="colorOnSecondary">@color/bg_white</item>
        <item name="android:colorBackground">@color/bg_white</item>
        <item name="colorSurface">@color/bg_white</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
        <item name="buttonBarPositiveButtonStyle">@style/EinkDialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/EinkDialogButton</item>
    </style>
    <style name="EinkDialogButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/text_black</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="rippleColor">@color/text_black</item>
    </style>
</resources>
